if (!INCLUDE["DSCL"]) {
    set(INCLUDE, "DSCL", true)
    if (!INCLUDE["STRING"]) {include("string")}
    
    function hashdscl() {
        CMD="dscl . readall /Users GeneratedUID NFSHomeDirectory PrimaryGroupID RealName RecordName RecordType SMBRID SMBSID UniqueID UserShell 2>/dev/null"
        Data=split(trim(system(CMD)), "\n")
        foreach Index, Value in Data {
            if (Value == "-") {
                set(Data, Index, "----")
            }
        }
        Data=join(Data, "\n")
        Data=split(Data,"----\n")
        UserHash={}
        foreach User in Data {
            UserName=""
            User=trim(User)
            User=replaceall(User, "\n ", " ")
            User=replaceall(User, ":\n", " ")
            UserData=split(User, "\n")
            TempHash={}
            foreach Line in UserData {
                SLine=split(trim(Line), ":")
                Key=SLine[0]
                Value=trim(SLine[1])
                switch(Key) {
                    case "NFSHomeDirectory" {
                        Value=fields(Value)
                    }
                    case "PrimaryGroupID" {
                        Value=int(Value)
                    }
                    case "UniqueID" {
                        Value=int(Value)
                    }
                    case "RecordName" {
                        SVal=fields(Value)
                        First=SVal[0]
                        UserName=First
                        if (len(SVal) > 1) {
                            Extra=trim(trimprefix(Value, First))
                            Value=[First, Extra]
                        }
                    }
                }
                set(TempHash, Key, Value)
            }
            set(UserHash, UserName, TempHash)
        }
        return UserHash
    }

    function dscl2pwd() {
        PWHash={}
        Data=hashdscl()
        foreach User in keys(Data) {
            if (len(User) > 0) {
                UserInfo=Data[User]
                NewHash={
                    "Uid": UserInfo["UniqueID"],
                    "Gid": UserInfo["PrimaryGroupID"],
                    "Home": UserInfo["NFSHomeDirectory"][0],
                    "Shell": UserInfo["UserShell"],
                    "Gecos": UserInfo["RealName"]
                }
                set(PWHash, User, NewHash)
            }
        }
        return(PWHash)
    }

    function getpwent(User="") {
        Data=dscl2pwd()
        FindUser=string(User)
        if (isnum(FindUser)) {
            User=int(User)
            foreach Entry in keys(Data) {
	        if (Data[Entry]["Uid"]  == User) {
                    FindUser=Entry
                }
            }
        }
        Temp=Data[FindUser]
        if (Temp) {set(Temp, "User", FindUser)}
        return Temp
    }

    function getpwuid(Uid=-1) {
        if (!checkfunctype("getpwuid", "integer", Uid, 1)) {
            exit(1)
        }
        if (Uid == -1) {
            println("Error calling `getpwuid`: ERROR: TypeError: getpwuid() takes exactly 1 argument (0 given)")
            exit(1)
        }
	    return getpwent(Uid)
    }

    function getpwnam(Username="") {
        if (!checkfunctype("getpwnam", "string", Username, 1)) {
            exit(1)
        }
        if (Username == "") {
            println("Error calling `getpwnam`: ERROR: TypeError: getpwnam() takes exactly 1 argument (0 given)")
            exit(1)
        }
	    return getpwent(Username)
    }
}
